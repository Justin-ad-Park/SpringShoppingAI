# 이 파일을 Spring-AI-Tutor/.env로 복사하세요. 실제 키를 커밋하지 마세요.
OPENAI_API_KEY=
TUTOR_CHAT_MODEL=gpt-4.1-mini
TUTOR_EMBEDDING_MODEL=text-embedding-3-small
TUTOR_PORT=8090
# OpenAI 호환 서버를 사용할 때만 변경
TUTOR_OPENAI_BASE_URL=https://api.openai.com
# 지원 모델을 확인한 뒤 활성화
TUTOR_NATIVE_SCHEMA=false
TUTOR_IMAGE_MODEL=gpt-image-1.5
TUTOR_TRANSCRIPTION_MODEL=whisper-1
TUTOR_SPEECH_MODEL=tts-1
TUTOR_MODERATION_MODEL=omni-moderation-latest
TUTOR_MCP_URL=http://127.0.0.1:8082
# 선택: scripts/pgvector-up.sh의 전용 DB
# TUTOR_PGVECTOR_URL=jdbc:postgresql://127.0.0.1:15432/tutor
# TUTOR_PGVECTOR_USER=tutor
# TUTOR_PGVECTOR_PASSWORD=local-tutor-only
